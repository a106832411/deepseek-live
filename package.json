{
  "name": "jinglive-app",
  "version": "0.1.0",
  "description": "鲸live：AI 虚拟主播直播控制台（Vue 3 + Electron）",
  "author": "鲸live",
  "main": "electron/main.cjs",
  "scripts": {
    "serve": "node server/index.cjs",
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "app": "vite build && electron .",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1 -Target nsis",
    "dist": "npm run build && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "vue": "^3.5.0"
  }
}
