# ============================================================
# 鲸live DeepLive · 环境变量示例
# 复制为 .env 后填写（.env 已在 .gitignore，不会入库）
# 真实环境变量优先于 .env，.env 优先于 config.json
# ============================================================

# ---------- 服务 ----------
# 服务端口（Electron 窗口和 HTTP/WS 都用它）
DEEPLIVE_PORT=8788

# ---------- AI（DeepSeek / 本地 Ollama / 任意 OpenAI 兼容接口）----------
# 本地模型示例（token 免费）：
#   DEEPLIVE_AI_BASE=http://127.0.0.1:11434/v1
#   DEEPLIVE_AI_MODEL=qwen2.5:7b
#   DEEPLIVE_AI_KEY=ollama

DEEPLIVE_AI_BASE=https://api.deepseek.com/v1
DEEPLIVE_AI_MODEL=deepseek-chat
DEEPLIVE_AI_KEY=sk-替换成你的Key
# 单条回复最大字数
DEEPLIVE_AI_MAX_CHARS=20
# 采样温度（0~1.5）
DEEPLIVE_AI_TEMPERATURE=1.0

# 主播人设（system prompt），换行用 \n
DEEPLIVE_PERSONA=你是直播间里的虚拟主播「小深」，说话自然简洁，偶尔带点小幽默。

# ---------- TTS（GPT-SoVITS 本地代理）----------
DEEPLIVE_TTS_URL=http://127.0.0.1:9881
# 参考音频绝对路径（wav）
DEEPLIVE_TTS_REF_AUDIO=D:/path/to/voice_ref.wav
# 参考音频里说的那句话 —— 必须和参考音【逐字一致】！
# 写错/写占位符会让声音又平又假（实测同一句会短成 1/3、语调全平），这是"机械感"最常见的原因。
DEEPLIVE_TTS_PROMPT_TEXT=这里填参考音频里说的那句话（逐字一致）
DEEPLIVE_TTS_SPEED=1.0
DEEPLIVE_TTS_STEPS=32
# 这三个是可听感的旋钮：temperature 越高语气起伏越大；top_k 25~30 比 20 自然；repetition_penalty 1.1~1.2 比 1.35 少"一个字一个字念"
DEEPLIVE_TTS_TOP_K=30
DEEPLIVE_TTS_TEMPERATURE=1.3
DEEPLIVE_TTS_REP=1.1
DEEPLIVE_TTS_AUTO_PLAY=true

# ---------- 抖音 ----------
# relay = 外部中继脚本 POST /api/douyin/ingest；browser = 内置网页钩子
DEEPLIVE_DOUYIN_MODE=relay
DEEPLIVE_DOUYIN_RID=替换成你的直播间号
DEEPLIVE_DOUYIN_ROOM_URL=https://live.douyin.com/替换成你的直播间号

# ---------- 点歌 / 清唱 ----------
DEEPLIVE_SONGS_ENABLED=true
DEEPLIVE_SONGS_INTERNAL=true
DEEPLIVE_SONGS_DEDUPE=true
DEEPLIVE_SONGS_AUTO_PLAY=true
DEEPLIVE_SONGS_MAX_QUEUE=20
# 音源优先级，逗号分隔：netease / qq（songs.perform=play 播原曲时用）
DEEPLIVE_SONGS_SOURCES=netease,qq
# 以下清唱参数默认从 config.json / 控制台读，无需写在这里；
# 取消注释 = 用 .env 强制覆盖（会盖掉控制台里的修改）。
# sing=清唱（TTS 合成自己的声音唱，不播原曲）；play=旧行为（播放原曲）
# DEEPLIVE_SONGS_PERFORM=sing

# ---------- 清唱（唱歌 = 用 TTS 合成清唱）----------
# DEEPLIVE_SING_ENABLED=true
# melody=带旋律清唱（音高按小调子走，更像唱歌） / read=纯念唱（自然朗读节奏）
# DEEPLIVE_SING_MODE=melody
# netease=抓原歌词来唱 / ai=抓不到就让 AI 现编几句
# DEEPLIVE_SING_LYRICS=netease
# 每首唱几句、整首歌词字数上限
# DEEPLIVE_SING_MAX_LINES=6
# DEEPLIVE_SING_MAX_CHARS=100
# 唱腔化 v2：按节拍拉长元音+连唱（更像在唱，整首会变长）；档位 0.55 保守 / 0.75 中等 / 0.95 明显
# DEEPLIVE_SING_V2=true
# DEEPLIVE_SING_BEAT_SCALE=0.75
# 清唱引擎：tts=TTS 清唱（快，默认）| ace=真唱（本地 ACE-Step + Seed-VC，慢但真唱）
# DEEPLIVE_SING_ENGINE=tts
# 唱之前报幕 / 唱完道谢
# DEEPLIVE_SING_INTRO=true
# DEEPLIVE_SING_OUTRO=true
# 旋律：auto（每首随机氛围）/ xiaoxingxing / shengri / folk1 / folk2
# DEEPLIVE_SING_MELODY=auto
# DEEPLIVE_SING_BPM=92
# DEEPLIVE_SING_VIBRATO=true
# DEEPLIVE_SING_GAP_MS=320
# 合成期间先垫的话（空字符串=不垫；合成慢会循环垫最多 2 次）
# DEEPLIVE_SING_FILLER=我清清嗓子，准备开唱啦～歌词有点长，我再看一眼～马上就好，再等我一下下～

# ---------- OBS（一键配置用）----------
DEEPLIVE_OBS_HOST=127.0.0.1
DEEPLIVE_OBS_PORT=4455
DEEPLIVE_OBS_PASSWORD=替换成你的OBS WebSocket密码
DEEPLIVE_OBS_SCENE=鲸live
DEEPLIVE_OBS_BG=0b0c0e
# simple=简单直播 / game=完整直播（旧版竖屏场景，含游戏画面）
DEEPLIVE_OBS_PRESET=simple

# ---------- 其它 ----------
# 同用户事件合并窗口（秒，0=不合并）
DEEPLIVE_MERGE_WINDOW=0
# 弹幕过滤词，逗号分隔（命中就丢弃）
DEEPLIVE_FILTER_BLOCKLIST=送出,送出了
